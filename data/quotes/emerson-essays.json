      "section": "self-reliance",
      "locator": "Self-Reliance",
      "tags": ["assertiveness"]
    },
    {
      "id": "foolish-consistency-hobgoblin-little",
      "text": "A foolish consistency is the hobgoblin of little minds, adored by little statesmen and philosophers and divines.",
      "section": "self-reliance",
      "locator": "Self-Reliance",
      "tags": ["philosophy"]
    },
    {
      "id": "speak-think-now-hard",
      "text": "Speak what you think now in hard words and tomorrow speak what tomorrow thinks in hard words again, though it contradict everything you said today.",
      "section": "self-reliance",
      "locator": "Self-Reliance",
      "tags": ["assertiveness"]
    },
    {
      "id": "great-misunderstood",
      "text": "To be great is to be misunderstood.",
      "section": "self-reliance",
      "locator": "Self-Reliance",
      "tags": ["assertiveness"]
    },
    {
      "id": "insist-on-yourself-never",
      "text": "Insist on yourself; never imitate.",
      "section": "self-reliance",
      "locator": "Self-Reliance",
      "tags": ["assertiveness", "self-development"]
    },
    {
      "id": "nothing-can-bring-peace",
      "text": "Nothing can bring you peace but yourself.",
      "section": "self-reliance",
      "locator": "Self-Reliance",
      "tags": ["self-development"]
    },
    {
      "id": "power-resides-him-new",
      "text": "The power which resides in him is new in nature, and none but he knows what that is which he can do, nor does he know until he has tried.",
