      "locator": "Self-Reliance",
      "tags": ["assertiveness"]
    },
    {
      "id": "nothing-at-last-sacred",
      "text": "Nothing is at last sacred but the integrity of your own mind.",
      "section": "self-reliance",
      "locator": "Self-Reliance",
      "tags": ["assertiveness", "philosophy"]
    },
    {
      "id": "must-do-all-concerns",
