{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProductPope/VerbeApp/data/schema/authors.schema.json",
  "title": "Authors",
  "type": "object",
  "required": ["authors"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/localizedString"
          },
          "born": {
            "$ref": "common.schema.json#/$defs/year"
          },
          "died": {
            "$ref": "common.schema.json#/$defs/year",
            "description": "Year of death. Omit only when it is unknown (e.g. for legendary ancient authors)."
          },
          "circa": {
            "description": "True when the life dates are approximate.",
            "type": "boolean"
          }
        }
      }
    }
  }
}
