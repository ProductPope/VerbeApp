{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProductPope/VerbeApp/data/schema/sources.schema.json",
  "title": "Sources",
  "description": "Published works quotes are taken from. Every source must be in the public domain and available as a digital edition the quotes can be verified against.",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "author", "language", "license", "edition"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "translator": {
            "description": "Translator of the English text, when the work was not written in English. The death year proves the translation is in the public domain.",
            "type": "object",
            "required": ["name", "died"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "died": {
                "$ref": "common.schema.json#/$defs/year"
              }
            }
          },
          "language": {
            "description": "Language of the text quoted from this edition.",
            "$ref": "common.schema.json#/$defs/languageCode"
          },
          "license": {
            "const": "public-domain"
          },
          "edition": {
            "oneOf": [
              {
                "$ref": "#/$defs/standardEbooks"
              },
              {
                "$ref": "#/$defs/gutenberg"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "standardEbooks": {
      "description": "A Standard Ebooks edition; quotes are verified against the chapter files in its Git repository.",
      "type": "object",
      "required": ["publisher", "url", "repository"],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "const": "Standard Ebooks"
        },
        "url": {
          "type": "string",
          "pattern": "^https://standardebooks\\.org/ebooks/[a-z0-9/-]+$"
        },
        "repository": {
          "description": "Git repository holding the edition's source, used to verify quotes word for word.",
          "type": "string",
          "pattern": "^https://github\\.com/standardebooks/[a-z0-9_-]+$"
        }
      }
    },
    "gutenberg": {
      "description": "A Project Gutenberg edition; quotes are verified against its plain-text file. Use it only for works Standard Ebooks does not publish.",
      "type": "object",
      "required": ["publisher", "url", "text"],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "const": "Project Gutenberg"
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.gutenberg\\.org/ebooks/[0-9]+$"
        },
        "text": {
          "description": "UTF-8 plain-text file of the edition.",
          "type": "string",
          "pattern": "^https://www\\.gutenberg\\.org/cache/epub/[0-9]+/pg[0-9]+\\.txt$"
        }
      }
    }
  }
}
