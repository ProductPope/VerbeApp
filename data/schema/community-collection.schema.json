{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProductPope/VerbeApp/data/schema/community-collection.schema.json",
  "title": "Community sayings",
  "description": "Original sayings and practical tips written for Verbe by its contributors and released under CC0. They are not quotes from literature and are always shown as such.",
  "type": "object",
  "required": ["contributor", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contributor": {
      "description": "Name or GitHub handle of the person who wrote every item in this file.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "tags", "license"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "text": {
            "description": "The saying or tip, in the contributor's own words.",
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/slug"
            }
          },
          "license": {
            "const": "CC0-1.0"
          },
          "inspiredBy": {
            "description": "Optional link to the discussion or idea that inspired the item (ideas are not copyrighted; wording must be original).",
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "translations": {
            "type": "object",
            "propertyNames": {
              "$ref": "common.schema.json#/$defs/languageCode"
            },
            "additionalProperties": {
              "$ref": "quote-collection.schema.json#/$defs/translation"
            }
          }
        }
      }
    }
  }
}
